{
  "name": "facturino-demo-node-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Atelier Dupont — a B2B SaaS billed end to end with Facturino, using the official Node.js SDK.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@facturino/node": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "5.7.3"
  }
}
