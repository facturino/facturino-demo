# Copy to .env (each demo loads it) and fill in your test-mode credentials.

# Test-mode API key (starts with fac_test_). NEVER commit a real key.
FACTURINO_API_KEY=fac_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base URL. Default targets the hosted API; point it at your local
# emulator (e.g. http://localhost:5001/.../v1) when developing offline.
FACTURINO_BASE_URL=https://facturino.com/api/v1

# Signing secret used to verify inbound webhook signatures.
# Shown when you create a webhook endpoint (webhookEndpoints.create).
FACTURINO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL where Facturino can reach this demo's /webhooks route.
# Locally, expose it with a tunnel (e.g. cloudflared / ngrok) and paste the
# https URL here so webhookEndpoints.create registers a reachable target.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Local HTTP port for the demo server.
PORT=4242
